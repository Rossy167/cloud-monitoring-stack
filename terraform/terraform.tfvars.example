# Copy this file to terraform.tfvars and fill in real values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored — never commit it, it holds your Grafana
# admin password. Only the variables below (no default in variables.tf) are
# required; everything else has a sane default there.

# GCP project ID to deploy into.
project_id = "your-gcp-project-id"

# Username to create on the VM and use for SSH.
ssh_user = "your-username"

# Path to your SSH public key (generate with `ssh-keygen -t ed25519` if needed).
ssh_pub_key_path = "~/.ssh/id_ed25519.pub"

# CIDR ranges allowed to SSH in — no default on purpose, to force a
# conscious choice instead of silently allowing the world in. Use your own
# public IP/32, e.g. find it with `curl -s ifconfig.me`.
ssh_source_ranges = ["203.0.113.4/32"]

# Grafana admin password (username is always "admin"). Pick something you
# haven't used elsewhere; this ends up in Terraform state.
grafana_admin_password = "pick-something-here"

# Optional: webhook URL Alertmanager sends notifications to (Slack incoming
# webhook, PagerDuty, custom endpoint, etc). Leave unset/commented to run
# with a no-op receiver that just swallows alerts instead of failing to start.
# alertmanager_webhook_url = "https://hooks.example.com/services/xxx"

# Your Google account email (the one you run `gcloud auth login` as, or the
# one you'll pick in the browser prompt from `gcloud compute ssh
# --tunnel-through-iap`). Required — grants that identity permission to open
# an IAP SSH tunnel to the VM, as a second, IP-independent path alongside
# ssh_source_ranges above. No default on purpose.
iap_ssh_accessor_email = "you@example.com"

# Optional: Tailscale auth key, so the VM joins your tailnet on first boot as
# a third, IP-independent SSH path (ssh to its stable `tailscale ip -4`
# address instead of its public IP). Generate one at
# https://login.tailscale.com/admin/settings/keys — a reusable, short-expiry
# key is a reasonable default. Leave unset/commented to skip Tailscale
# entirely; nothing else in this stack depends on it.
# tailscale_auth_key = "tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
