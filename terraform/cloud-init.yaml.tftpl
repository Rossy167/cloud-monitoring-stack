#cloud-config
package_update: true
package_upgrade: false

packages:
  - fail2ban
  - ca-certificates
  - curl
  - gnupg

write_files:
  - path: /opt/monitoring/docker-compose.yml
    encoding: b64
    permissions: '0644'
    content: ${docker_compose_b64}

  - path: /opt/monitoring/prometheus/prometheus.yml
    encoding: b64
    permissions: '0644'
    content: ${prometheus_b64}

  - path: /opt/monitoring/prometheus/rules/alerts.yml
    encoding: b64
    permissions: '0644'
    content: ${prometheus_rules_b64}

  - path: /opt/monitoring/blackbox/blackbox.yml
    encoding: b64
    permissions: '0644'
    content: ${blackbox_b64}

  - path: /opt/monitoring/alertmanager/alertmanager.yml
    encoding: b64
    permissions: '0644'
    content: ${alertmanager_b64}

  - path: /opt/monitoring/caddy/Caddyfile
    encoding: b64
    permissions: '0644'
    content: ${caddyfile_b64}

  - path: /opt/monitoring/grafana/provisioning/datasources/datasource.yml
    encoding: b64
    permissions: '0644'
    content: ${grafana_datasource_b64}

  - path: /opt/monitoring/grafana/provisioning/dashboards/dashboard.yml
    encoding: b64
    permissions: '0644'
    content: ${grafana_dashboard_provisioning_b64}

  - path: /opt/monitoring/grafana/dashboards/infra-overview.json
    encoding: b64
    permissions: '0644'
    content: ${grafana_dashboard_json_b64}

  - path: /opt/monitoring/scripts/fail2ban-metrics.sh
    encoding: b64
    permissions: '0755'
    content: ${fail2ban_script_b64}

  - path: /etc/fail2ban/jail.local
    encoding: b64
    permissions: '0644'
    content: ${fail2ban_jail_local_b64}

runcmd:
  # 2GB swapfile as an OOM safety net: containers' mem_limits alone sum to ~816Mi
  # on this 1024Mi e2-micro, leaving little headroom for host OS/daemon overhead.
  # Swap doesn't fix sustained over-commitment, but gives the kernel room to
  # reclaim/page under a transient burst instead of the OOM killer taking out a
  # host-critical process. Guarded so a re-triggered runcmd is a no-op.
  # low vm.swappiness keeps swap as an emergency cushion, not routine paging,
  # since actually swapping is slow on this class of VM.
  - |
    if [ ! -f /swapfile ]; then
      fallocate -l 2G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
  - echo 'vm.swappiness=10' > /etc/sysctl.d/99-swappiness.conf
  - sysctl -p /etc/sysctl.d/99-swappiness.conf
  - mkdir -p /var/lib/node_exporter/textfile_collector
  - systemctl enable fail2ban
  # jail.local (with [sshd] enabled) is already written by this point —
  # write_files always runs before runcmd — so this restart is what makes
  # the sshd jail actually active on first boot instead of staying disabled.
  - systemctl restart fail2ban
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ${ssh_user}
  - (crontab -l 2>/dev/null; echo "* * * * * /opt/monitoring/scripts/fail2ban-metrics.sh") | crontab -
  - /opt/monitoring/scripts/fail2ban-metrics.sh
  - sleep 5
  - cd /opt/monitoring && docker compose up -d
