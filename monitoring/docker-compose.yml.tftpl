version: "3.9"

networks:
  monitoring:
    driver: bridge

volumes:
  prometheus_data:
  grafana_data:
  caddy_data:
  caddy_config:

services:
  prometheus:
    image: prom/prometheus:v2.54.1
    container_name: prometheus
    restart: unless-stopped
    mem_limit: 256m
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=15d"
    networks:
      - monitoring
    healthcheck:
      # Prometheus's own web toolkit exposes /-/healthy for exactly this purpose.
      # The image is based on the prometheus busybox base, which includes wget.
      test: ["CMD-SHELL", "wget -q -O- http://localhost:9090/-/healthy >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: alertmanager
    restart: unless-stopped
    mem_limit: 128m
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
    networks:
      - monitoring
    healthcheck:
      # Alertmanager exposes /-/healthy the same way Prometheus does.
      test: ["CMD-SHELL", "wget -q -O- http://localhost:9093/-/healthy >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  node-exporter:
    image: prom/node-exporter:v1.8.2
    container_name: node-exporter
    restart: unless-stopped
    pid: host
    mem_limit: 48m
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /var/lib/node_exporter/textfile_collector:/textfile_collector:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.textfile.directory=/textfile_collector"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    networks:
      - monitoring
    healthcheck:
      # node-exporter's image (prom/node-exporter) is built on busybox and,
      # despite being a minimal/distroless-style image, does ship busybox
      # wget at /bin/wget (verified: `docker run --entrypoint sh
      # prom/node-exporter:v1.8.2 -c 'which wget'`). There's no dedicated
      # /-/healthy endpoint, so a 200 from /metrics is used as the liveness
      # signal instead.
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:9100/metrics >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.49.1
    container_name: cadvisor
    restart: unless-stopped
    mem_limit: 96m
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    networks:
      - monitoring
    healthcheck:
      # cAdvisor's image ships busybox wget at /usr/bin/wget (verified the
      # same way as node-exporter above), and cAdvisor exposes a dedicated
      # /healthz endpoint for exactly this purpose.
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:8080/healthz >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  blackbox-exporter:
    image: prom/blackbox-exporter:v0.25.0
    container_name: blackbox-exporter
    restart: unless-stopped
    mem_limit: 48m
    volumes:
      - ./blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    networks:
      - monitoring
    healthcheck:
      # Same busybox wget as node-exporter (verified), and blackbox_exporter
      # exposes /-/healthy the same way Prometheus/Alertmanager do.
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:9115/-/healthy >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  grafana:
    image: grafana/grafana:11.2.0
    container_name: grafana
    restart: unless-stopped
    mem_limit: 192m
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=${grafana_admin_password}
      - GF_USERS_ALLOW_SIGN_UP=false
      # Public Dashboards has been GA and enabled-by-default since Grafana
      # 10.3 (this stack runs 11.2.0, well past that), so this toggle is
      # belt-and-suspenders rather than strictly required. It only unlocks
      # the *capability* to mark an individual dashboard public (read-only,
      # no login) via Share > Public dashboard in the UI, one dashboard at a
      # time. It does NOT make Grafana itself anonymously accessible — that
      # would be GF_AUTH_ANONYMOUS_ENABLED, which is intentionally not set
      # here. No dashboard is public until an admin explicitly marks one
      # public via Grafana's UI/API after deploy.
      - GF_FEATURE_TOGGLES_ENABLE=publicDashboards
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring
    healthcheck:
      # Recent grafana/grafana images ship curl (verified: `docker run
      # --entrypoint sh grafana/grafana:11.2.0 -c 'which curl'`), and Grafana
      # exposes its own /api/health endpoint (checks DB connectivity too),
      # no auth required.
      test: ["CMD-SHELL", "curl -sf http://127.0.0.1:3000/api/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  caddy:
    image: caddy:2.8-alpine
    container_name: caddy
    restart: unless-stopped
    mem_limit: 48m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - monitoring
    healthcheck:
      # The caddy:*-alpine base image does NOT include curl, but it does
      # include busybox wget and nc (verified: `docker run --entrypoint sh
      # caddy:2.8-alpine -c 'which curl wget nc'` -> curl not found, wget and
      # nc found). Caddy's admin API binds to 127.0.0.1:2019 by default and
      # responds to GET /config/ with the active JSON config, which is a
      # real liveness/readiness signal (confirmed to return 200 against a
      # running container). Must use 127.0.0.1, not localhost: the admin API
      # only listens on the IPv4 loopback, and busybox wget resolves
      # localhost to ::1 first and fails with connection refused there.
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:2019/config/ >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
