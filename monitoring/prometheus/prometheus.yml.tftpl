global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  # Prometheus monitoring itself
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Host-level metrics (CPU, memory, disk, network)
  - job_name: "node"
    static_configs:
      - targets: ["node-exporter:9100"]

  # Per-container metrics for everything running in Docker on this box
  - job_name: "cadvisor"
    static_configs:
      - targets: ["cadvisor:8080"]

  # External uptime + latency + TLS cert expiry, all from one blackbox probe.
  # blackbox_exporter automatically emits probe_ssl_earliest_cert_expiry for
  # any https:// target, so cert monitoring needs no extra config.
  - job_name: "blackbox-http"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://rossy167.github.io
          - https://${static_ip}.sslip.io
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
